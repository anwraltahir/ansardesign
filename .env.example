# ====================================================================
# منصة المصمم الذكي – جماعة أنصار السنة المحمدية بالسودان (أمانة الدعوة)
# Official Domain: design.ansaralsuna.net
# ====================================================================

# Port for the Node.js server
PORT=3000
NODE_ENV=production

# Application URL
APP_URL=https://design.ansaralsuna.net

# JWT Secret for Admin Authentication (Change in production!)
JWT_SECRET=super_secret_ansar_al_sunna_key_replace_in_production_2026

# PostgreSQL Database Configuration
# Option 1: Direct Connection URI
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/ansar_design_db

# Option 2: Discrete parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=ansar_design_db

# Storage Path (Default: ./uploads)
UPLOADS_DIR=/var/www/ansar-smart-design/uploads
