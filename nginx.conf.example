# ====================================================================
# Nginx Configuration for: design.ansaralsuna.net
# Smart Design Platform - Ansar Al-Sunna Sudan (Dawah Secretariat)
# Location: /etc/nginx/sites-available/design.ansaralsuna.net
# ====================================================================

# HTTP - Redirect all traffic to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name design.ansaralsuna.net;

    # Let's Encrypt validation
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name design.ansaralsuna.net;

    # SSL Certificates (managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/design.ansaralsuna.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/design.ansaralsuna.net/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval';" always;

    # Maximum file upload size for sheikh photos, calligraphy and posters
    client_max_body_size 35M;

    # Direct static cache for user uploads
    location /uploads/ {
        alias /var/www/ansar-smart-design/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # Direct static cache for built frontend assets
    location /assets/ {
        alias /var/www/ansar-smart-design/dist/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Reverse proxy to Node.js / Express application (running on port 3000 via PM2)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90;
    }
}
